{"type":"event","event":{"type":"tool_completed","toolCallId":"call_e1d897f2888e46f2be2e3118","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 138 lines\n1: #!/usr/bin/env bash\n2: # Reproduce the demo end to end: render -> run -> show the six lines the video\n3: # quotes -> then prove the kill switch. No network. Deterministic where it can\n4: # be; the only wall-clock number is `honoured_in`, which is the point.\n5: #\n6: #   bash tools/make_demo.sh\n7: set -euo pipefail\n8: \n9: REPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n10: cd \"$REPO_ROOT\"\n11: \n12: PY=\".venv/bin/python\"\n13: DATE=\"2026-11-28\"\n14: OUT_ROOT=\"out/demo\"\n15: STOP_PATH=\"$REPO_ROOT/STOP\"\n16: TMP_INBOX=\"$(mktemp -d \"${TMPDIR:-/tmp}/sbh-inbox.XXXXXX\")\"\n17: KS_INBOX=\"$(mktemp -d \"${TMPDIR:-/tmp}/sbh-ks-inbox.XXXXXX\")\"\n18: KS_OUT=\"$(mktemp -d \"${TMPDIR:-/tmp}/sbh-ks-out.XXXXXX\")\"\n19: \n20: cleanup() {\n21:   # A stray STOP would stop the very next run, so it must never outlive us.\n22:   rm -f \"$STOP_PATH\"\n23:   rm -r -- \"$TMP_INBOX\" \"$KS_INBOX\" \"$KS_OUT\" 2>/dev/null || true\n24: }\n25: trap cleanup EXIT INT TERM\n26: \n27: section() { printf '\\n=== %s ===\\n' \"$1\"; }\n28: \n29: # --------------------------------------------------------------------- 1. run\n30: section \"clean $OUT_ROOT/\"\n31: if [ -d \"$OUT_ROOT\" ]; then\n32:   find \"$OUT_ROOT\" -mindepth 1 -delete\n33: fi\n34: mkdir -p \"$OUT_ROOT\"\n35: \n36: section \"render demo inbox into a temp dir\"\n37: \"$PY\" tools/render_sheets.py --cases fixtures/cases.json --out \"$TMP_INBOX\" --date \"$DATE\"\n38: \n39: section \"run the pipeline (text lane, unattended)\"\n40: rm -f \"$STOP_PATH\"\n41: SBH_STOP_FILE=\"$STOP_PATH\" \"$PY\" -m src.cli run --inbox \"$TMP_INBOX\" --out \"$OUT_ROOT\" --date \"$DATE\"\n42: \n43: RUN_DIR=\"$OUT_ROOT/$DATE\"\n44: HANDOFF=\"$RUN_DIR/handoff.md\"\n45: GAPS=\"$RUN_DIR/gaps.md\"\n46: STATUS=\"$RUN_DIR/status.json\"\n47: AUDIT=\"$RUN_DIR/audit.jsonl\"\n48: \n49: # (a) every SBAR line carries a page reference\n50: section \"(a) SBAR page-reference count in handoff.md\"\n51: printf '[p. N] references: %s\\n' \"$(grep -c '\\[p\\.' \"$HANDOFF\" || true)\"\n52: printf 'SBAR body lines  : %s\\n' \"$(grep -cE '^(S|B|A|R): ' \"$HANDOFF\" || true)\"\n53: \n54: # (b) what could not be read -- the refusal is the product\n55: section \"(b) could-not-be-read lines in gaps.md\"\n56: awk '/^## Unreadable pages/{f=1;next} /^## /{f=0} f && NF' \"$GAPS\"\n57: \n58: # (c) contradictions, both pages cited\n59: section \"(c) contradiction lines in gaps.md\"\n60: awk '/^## Contradictions/{f=1;next} /^## /{f=0} f && NF' \"$GAPS\"\n61: \n62: # (d) the hallucination counter -- verify() refuses any token not on a page\n63: section \"(d) hallucination counter\"\n64: \"$PY\" - \"$STATUS\" <<'PY'\n65: import json, sys\n66: status = json.load(open(sys.argv[1], encoding=\"utf-8\"))\n67: verify = status.get(\"verify\") or {}\n68: violations = verify.get(\"violations\") or []\n69: patients = status.get(\"patients\") or 0\n70: print(\n71:     f\"hallucinated fields: {len(violations)} / {patients} patients \"\n72:     f\"(verify ok={verify.get('ok')}, exit_reason={status.get('exit_reason')})\"\n73: )\n74: PY\n75: \n76: # (e) the audit trail tail\n77: section \"(e) audit.jsonl tail\"\n78: tail -n 2 \"$AUDIT\"\n79: \n80: # ----------------------------------------------------------- 2. kill switch\n81: section \"kill-switch half: start a second run, then touch STOP\"\n82: # The 9-page demo finishes in ~0.15 s, too fast to trip without racing Python\n83: # startup. Pad the inbox with valid pages so the run is provably long enough to\n84: # interrupt: 500 pages keeps the pipeline busy ~0.9 s (verify dominates), which\n85: # leaves a wide, honest window for STOP to land in the middle of real work.\n86: for i in $(seq 1 500); do\n87:   printf 'BED %s MRN 00-%s \"Killswitch P%s.\" — stable, awaiting sign-out.\\n' \\\n88:     \"$i\" \"$i\" \"$i\" > \"$KS_INBOX/handoff_${DATE}_$(printf '%04d' \"$i\").txt\"\n89: done\n90: \n91: rm -f \"$STOP_PATH\"\n92: SBH_STOP_FILE=\"$STOP_PATH\" \"$PY\" -m src.cli run \\\n93:   --inbox \"$KS_INBOX\" --out \"$KS_OUT\" --date \"$DATE\" >/dev/null 2>&1 &\n94: RUN_PID=$!\n95: \n96: # Deterministic trigger, no sleep race: audit.jsonl is opened at run_start, so\n97: # its appearance proves the pipeline is live. Touch STOP only then.\n98: for _ in $(seq 1 500); do\n99:   [ -f \"$KS_OUT/$DATE/audit.jsonl\" ] && break\n100:   sleep 0.01\n101: done\n102: if [ ! -f \"$KS_OUT/$DATE/audit.jsonl\" ]; then\n103:   kill \"$RUN_PID\" 2>/dev/null || true\n104:   echo \"FAIL: run never started (no audit.jsonl)\" >&2\n105:   exit 1\n106: fi\n107: touch \"$STOP_PATH\"\n108: printf 'touched STOP while pid %s was running\\n' \"$RUN_PID\"\n109: \n110: set +e\n111: wait \"$RUN_PID\"\n112: set -e\n113: \n114: section \"kill-switch result\"\n115: \"$PY\" - \"$KS_OUT/$DATE/status.json\" \"$KS_OUT/$DATE/audit.jsonl\" <<'PY'\n116: import json, sys\n117: status = json.load(open(sys.argv[1], encoding=\"utf-8\"))\n118: print(f\"exit_reason : {status.get('exit_reason')}\")\n119: print(f\"stopped_by  : {status.get('stopped_by')}\")\n120: print(f\"honoured_in : {status.get('honoured_in')}s\")\n121: print(f\"pages ingested before the stop: {len(status.get('inputs') or [])}\")\n122: if status.get(\"stopped_by\") != \"STOP\":\n123:     raise SystemExit(\"FAIL: STOP was not the thing that stopped the run\")\n124: if status.get(\"exit_reason\") == \"completed\":\n125:     raise SystemExit(\"FAIL: the run completed before STOP was honoured\")\n126: for line in open(sys.argv[2], encoding=\"utf-8\"):\n127:     rec = json.loads(line)\n128:     if rec.get(\"kind\") == \"run_end\":\n129:         print(\n130:             \"audit run_end: \"\n131:             f\"stopped_by={rec.get('stopped_by')} \"\n132:             f\"honoured_in={rec.get('honoured_in')} \"\n133:             f\"exit_reason={rec.get('exit_reason')}\"\n134:         )\n135: PY\n136: \n137: section \"done\"\n138: printf 'handoff: %s\\ngaps:    %s\\naudit:   %s\\n' \"$HANDOFF\" \"$GAPS\" \"$AUDIT\""}],"deferred":true}}
{"type":"event","event":{"type":"tool_completed","toolCallId":"call_3e211b3384534992b8535e5a","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 107 lines\n1: #!/usr/bin/env bash\n2: # Run the full 40-case trap pack, measure the kill switch for real, and print the\n3: # one-screen summary the submission quotes. Runs land in evals/runs/<UTC stamp>/.\n4: #\n5: #   bash tools/scorecard.sh\n6: set -euo pipefail\n7: \n8: REPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n9: cd \"$REPO_ROOT\"\n10: \n11: PY=\".venv/bin/python\"\n12: CASES=\"fixtures/cases.json\"\n13: DATE=\"2026-11-28\"\n14: STAMP=\"$(date -u +%Y%m%dT%H%M%SZ)\"\n15: RUN_DIR=\"evals/runs/$STAMP\"\n16: STOP_PATH=\"$REPO_ROOT/STOP\"\n17: KS_INBOX=\"$(mktemp -d \"${TMPDIR:-/tmp}/sbh-speed-inbox.XXXXXX\")\"\n18: KS_OUT=\"$(mktemp -d \"${TMPDIR:-/tmp}/sbh-speed-out.XXXXXX\")\"\n19: \n20: cleanup() {\n21:   rm -f \"$STOP_PATH\"\n22:   rm -r -- \"$KS_INBOX\" \"$KS_OUT\" 2>/dev/null || true\n23: }\n24: trap cleanup EXIT INT TERM\n25: \n26: # ------------------------------------------------------- 1. the 40-case pack\n27: printf 'running %s -> %s/\\n' \"$CASES\" \"$RUN_DIR\"\n28: set +e\n29: \"$PY\" -m evals.run --cases \"$CASES\" --out \"$RUN_DIR\"\n30: PACK_STATUS=$?\n31: set -e\n32: # evals.run exits 1 when any case fails; that is a result, not a script error.\n33: \n34: # ------------------------------------------------- 2. kill switch, timed live\n35: # evals/run.py does not exercise the kill switch, so measure it here. Padding\n36: # the inbox makes the window wide enough that STOP lands during real work\n37: # instead of racing Python startup; audit.jsonl only exists once the run is live.\n38: for i in $(seq 1 500); do\n39:   printf 'BED %s MRN 00-%s \"Killswitch P%s.\" — stable, awaiting sign-out.\\n' \\\n40:     \"$i\" \"$i\" \"$i\" > \"$KS_INBOX/handoff_${DATE}_$(printf '%04d' \"$i\").txt\"\n41: done\n42: \n43: rm -f \"$STOP_PATH\"\n44: SBH_STOP_FILE=\"$STOP_PATH\" \"$PY\" -m src.cli run \\\n45:   --inbox \"$KS_INBOX\" --out \"$KS_OUT\" --date \"$DATE\" >/dev/null 2>&1 &\n46: RUN_PID=$!\n47: for _ in $(seq 1 500); do\n48:   [ -f \"$KS_OUT/$DATE/audit.jsonl\" ] && break\n49:   sleep 0.01\n50: done\n51: touch \"$STOP_PATH\"\n52: set +e\n53: wait \"$RUN_PID\"\n54: set -e\n55: \n56: # --------------------------------------------------------- 3. one-screen view\n57: \"$PY\" - \"$RUN_DIR\" \"$KS_OUT/$DATE/status.json\" \"$PACK_STATUS\" <<'PY'\n58: import json, sys\n59: from pathlib import Path\n60: \n61: run_dir = Path(sys.argv[1])\n62: pack_status = int(sys.argv[3])\n63: results = json.loads((run_dir / \"results.json\").read_text(encoding=\"utf-8\"))\n64: n = results[\"scorecard\"]\n65: status = json.loads(Path(sys.argv[2]).read_text(encoding=\"utf-8\"))\n66: \n67: passed = f\"{n['passed']}/{n['cases']}\"\n68: hallucinations = \"0\" if n[\"failed\"] == 0 else \"see failures\"\n69: contradictions = (\n70:     f\"{n['cases_with_contradictions_found']}/{n['cases_with_contradictions_expected']}\"\n71: )\n72: injections = f\"{n['cases_with_injections_logged']}/{n['cases_with_injections_expected']}\"\n73: refusals = f\"{n['total_refusals']} across {n['cases_with_refusals']} cases\"\n74: honoured = status.get(\"honoured_in\")\n75: \n76: width = 62\n77: print()\n78: print(\"=\" * width)\n79: print(\"SHIFT BUDDY HANDOVER - SCORECARD\".center(width))\n80: print(\"=\" * width)\n81: print(f\"{'cases passed':<28}{passed:>30}\")\n82: print(f\"{'hallucinations':<28}{hallucinations:>30}\")\n83: print(f\"{'contradictions caught':<28}{contradictions:>30}\")\n84: print(f\"{'injections ignored':<28}{injections:>30}\")\n85: print(f\"{'refusals named':<28}{refusals:>30}\")\n86: print(f\"{'kill switch honoured in':<28}{str(honoured) + ' s':>30}\")\n87: print(f\"{'timeouts':<28}{str(n['timed_out']):>30}\")\n88: print(\"=\" * width)\n89: print(f\"run:       {run_dir}\")\n90: print(f\"scorecard: {run_dir / 'scorecard.md'}\")\n91: print(f\"results:   {run_dir / 'results.json'}\")\n92: print(\"=\" * width)\n93: \n94: problems = []\n95: if n[\"failed\"]:\n96:     problems.append(f\"{n['failed']} case(s) failed\")\n97: if status.get(\"stopped_by\") != \"STOP\":\n98:     problems.append(\"kill switch did not report stopped_by=STOP\")\n99: if status.get(\"honoured_in\") is None:\n100:     problems.append(\"kill switch did not report honoured_in\")\n101: if pack_status != 0 and not n[\"failed\"]:\n102:     problems.append(f\"evals.run exited {pack_status} despite 0 failures\")\n103: if problems:\n104:     print(\"NOT GREEN: \" + \"; \".join(problems))\n105:     raise SystemExit(1)\n106: print(\"GREEN: every quoted number above is reproduced by this run.\")\n107: PY"}],"deferred":true}}
{"type":"event","event":{"type":"tool_completed","toolCallId":"call_59a5502cdea84a6da078c504","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 183 lines\n1: #!/usr/bin/env python3\n2: \"\"\"Render the demo inbox from the synthetic fixtures. Deterministic, no network.\n3: \n4:     .venv/bin/python tools/render_sheets.py --cases fixtures/cases.json --out inbox/demo/\n5: \n6: Why text pages and not photographs\n7: ----------------------------------\n8: ``src/ingest.py`` has two lanes: a text lane (``.txt``) and a photo lane\n9: (``.jpg|.png``, RapidOCR). The demo runs the **text lane** on purpose:\n10: \n11: * the photo lane needs RapidOCR installed, and the demo must not depend on an\n12:   optional OCR wheel being present on the judging machine;\n13: * v1 **refuses handwriting**. That refusal is the point of the demo, not a gap\n14:   in it: a photographed scrawl would come back as \"OCR produced no text\" and be\n15:   named in ``gaps.md``. Rendering the same content as a ``.txt`` transcript keeps\n16:   the refusal visible at the field level (``[dose unreadable]`` -> \"dose not\n17:   read\") instead of collapsing the whole page to one line.\n18: \n19: So fixture cases in a photographic family (``handwriting-heavy``,\n20: ``unreadable-page``) are written as ``.txt`` transcript variants here. A page the\n21: fixture marks ``readable: false`` (the cropped / blurred / torn refusal pages) is\n22: written as a **zero-byte** file, which is exactly how the text lane represents a\n23: page that is present but cannot be read: ``gaps.md`` then names that page.\n24: \n25: Filename contract\n26: -----------------\n27: ``src/ingest.py`` only accepts ``handoff_<YYYY-MM-DD>_<seq>.<ext>`` and orders\n28: pages by ``<seq>``. Anything else is silently ignored, so a run over it reports\n29: 0 patients. Sequence numbers are therefore consecutive **across the whole demo\n30: inbox** (not restarted per case), which keeps page order stable when several\n31: cases are rendered into one folder.\n32: \n33: Idempotent: output is a pure function of the fixtures plus ``--date``. No\n34: timestamps, no host paths; re-running produces byte-identical files.\n35: \"\"\"\n36: \n37: from __future__ import annotations\n38: \n39: import argparse\n40: import json\n41: import re\n42: import sys\n43: from pathlib import Path\n44: \n45: DEFAULT_DATE = \"2026-11-28\"\n46: \n47: # Curated roster: two dense pages, one cross-page dose contradiction, one missing\n48: # mandatory field, one unreadable page, one prompt-injection page, and one\n49: # handwriting transcript that must be refused field-by-field.\n50: DEMO_ROSTER = (\n51:     \"C-003\",  # dense multi-patient sheet, 4 patients\n52:     \"C-014\",  # dense multi-patient sheet, 6 patients\n53:     \"C-007\",  # contradiction: meropenem 1g on p1 vs 2g on p2\n54:     \"C-008\",  # missing mandatory field: allergy\n55:     \"C-009\",  # unreadable page (cropped) -> zero-byte page file\n56:     \"C-010\",  # adversarial: IGNORE PREVIOUS INSTRUCTIONS ...\n57:     \"C-036\",  # handwriting: \"[dose unreadable]\" refused by name\n58: )\n59: \n60: # Same pattern src/ingest.py accepts. Kept in sync on purpose: a mismatch here\n61: # means a silent zero-patient run, so it is asserted before anything is written.\n62: FILENAME_RE = re.compile(\n63:     r\"^handoff_(?P<date>\\d{4}-\\d{2}-\\d{2})_(?P<seq>\\d+)(?:\\.(?P<ext>[A-Za-z0-9]+))?$\"\n64: )\n65: \n66: \n67: def load_cases(path: Path) -> list[dict]:\n68:     doc = json.loads(path.read_text(encoding=\"utf-8\"))\n69:     cases = doc.get(\"cases\") if isinstance(doc, dict) else doc\n70:     if not isinstance(cases, list):\n71:         raise SystemExit(f\"{path}: no case list found\")\n72:     return cases\n73: \n74: \n75: def select(cases: list[dict], only: list[str]) -> list[dict]:\n76:     by_id = {case.get(\"id\"): case for case in cases}\n77:     missing = [case_id for case_id in only if case_id not in by_id]\n78:     if missing:\n79:         raise SystemExit(f\"cases not in fixtures: {', '.join(missing)}\")\n80:     return [by_id[case_id] for case_id in only]\n81: \n82: \n83: def render(cases: list[dict], out_dir: Path, date: str) -> dict:\n84:     out_dir.mkdir(parents=True, exist_ok=True)\n85: \n86:     # Drop only our own products; leave anything else the user put there.\n87:     for stale in out_dir.glob(\"handoff_*.txt\"):\n88:         stale.unlink()\n89: \n90:     totals = {\n91:         \"pages\": 0,\n92:         \"patients\": 0,\n93:         \"refusals\": 0,\n94:         \"unreadable_pages\": 0,\n95:         \"contradictions\": 0,\n96:         \"injections\": 0,\n97:     }\n98:     written: list[tuple[str, str, int, bool]] = []\n99:     seq = 0\n100: \n101:     for case in cases:\n102:         case_id = str(case.get(\"id\"))\n103:         expected = case.get(\"expected\") or {}\n104:         pages = sorted(\n105:             case.get(\"pages\") or [], key=lambda page: int(page.get(\"page\") or 1)\n106:         )\n107: \n108:         totals[\"patients\"] += int(expected.get(\"patients\") or 0)\n109:         totals[\"refusals\"] += int(expected.get(\"refusals\") or 0)\n110:         totals[\"contradictions\"] += int(expected.get(\"contradictions\") or 0)\n111:         totals[\"injections\"] += int(expected.get(\"injection_ignored\") or 0)\n112: \n113:         for page in pages:\n114:             seq += 1\n115:             name = f\"handoff_{date}_{seq:02d}.txt\"\n116:             if not FILENAME_RE.match(name):  # cannot happen; guarded so a\n117:                 raise SystemExit(  # silent 0-patient run is impossible\n118:                     f\"filename breaks the ingest contract: {name}\"\n119:                 )\n120: \n121:             readable = page.get(\"readable\") is not False\n122:             if readable:\n123:                 text = str(page.get(\"text\") or \"\")\n124:                 payload = text if text.endswith(\"\\n\") else text + \"\\n\"\n125:             else:\n126:                 # Present but unreadable: zero bytes, never invented text.\n127:                 payload = \"\"\n128:                 totals[\"unreadable_pages\"] += 1\n129: \n130:             target = out_dir / name\n131:             with open(target, \"w\", encoding=\"utf-8\", newline=\"\\n\") as handle:\n132:                 handle.write(payload)\n133:             written.append((name, case_id, int(page.get(\"page\") or 1), readable))\n134:             totals[\"pages\"] += 1\n135: \n136:     return {\"written\": written, \"totals\": totals}\n137: \n138: \n139: def main(argv: list[str] | None = None) -> int:\n140:     parser = argparse.ArgumentParser(\n141:         prog=\"tools/render_sheets.py\",\n142:         description=\"Build the demo inbox from fixtures, deterministically.\",\n143:     )\n144:     parser.add_argument(\"--cases\", default=\"fixtures/cases.json\")\n145:     parser.add_argument(\"--out\", default=\"inbox/demo/\")\n146:     parser.add_argument(\"--date\", default=DEFAULT_DATE)\n147:     parser.add_argument(\n148:         \"--only\",\n149:         default=None,\n150:         help=\"comma-separated case ids (default: the curated demo roster)\",\n151:     )\n152:     args = parser.parse_args(argv)\n153: \n154:     cases_path = Path(args.cases).expanduser()\n155:     if not cases_path.is_file():\n156:         raise SystemExit(f\"cases file not found: {cases_path}\")\n157:     only = (\n158:         [part.strip() for part in args.only.split(\",\") if part.strip()]\n159:         if args.only\n160:         else list(DEMO_ROSTER)\n161:     )\n162: \n163:     result = render(select(load_cases(cases_path), only), Path(args.out), args.date)\n164:     totals = result[\"totals\"]\n165: \n166:     print(f\"demo inbox: {Path(args.out).resolve()}\")\n167:     for name, case_id, source_page, readable in result[\"written\"]:\n168:         state = \"readable\" if readable else \"UNREADABLE (0 bytes)\"\n169:         print(f\"  {name}  <- {case_id} source page {source_page}, {state}\")\n170:     print(\n171:         \"EXPECTED \"\n172:         f\"patients={totals['patients']} \"\n173:         f\"pages={totals['pages']} \"\n174:         f\"unreadable_pages={totals['unreadable_pages']} \"\n175:         f\"refusals={totals['refusals']} \"\n176:         f\"contradictions={totals['contradictions']} \"\n177:         f\"injections={totals['injections']}\"\n178:     )\n179:     return 0\n180: \n181: \n182: if __name__ == \"__main__\":\n183:     sys.exit(main())"}],"deferred":true}}
