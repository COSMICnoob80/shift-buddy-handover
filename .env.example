# Shift Buddy Handover — environment template
# Copy to .env and fill. NO cloud keys exist in this project by design:
# all processing is local, patient data must not leave the machine.
# .env is gitignored — never commit it.

# Watched folder the photos land in (relative to repo root)
SBH_INBOX=./inbox

# Output directory (handoff, gaps, audit, summary)
SBH_OUT=./out

# Optional: local GGUF instruction model for narrative composition.
# NOT WIRED IN v1 — the submitted composer is a deterministic template
# (status.json reports model: "template"). Kept here for the lane described
# in STACK-FREEZE.md. Leave blank and nothing is downloaded or loaded.
SBH_MODEL_PATH=
SBH_MODEL_CTX=4096

# OCR language hint. The v1 image lane uses RapidOCR (not tesseract), which
# ships its own models; this variable is unused by the submitted path.
SBH_TESSERACT_LANG=eng

# Kill switch: the agent polls this file; its appearance stops the run
SBH_STOP_FILE=./STOP
